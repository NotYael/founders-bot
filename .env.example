# Copy this file to .env and fill in the values. NEVER commit .env.

# Bot token: Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID: Developer Portal -> your app -> General Information
CLIENT_ID=

# Optional: your server's ID (right-click server icon -> Copy Server ID, needs Developer Mode).
# If set, `npm run deploy` registers commands to this server only (instant updates).
# If empty, commands are registered globally (can take up to an hour to appear).
GUILD_ID=
